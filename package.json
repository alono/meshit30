{
  "name": "meshit30-trainer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Exam trainer for the Israeli RASPAN Meshit-30 theory exams",
  "license": "MIT",
  "author": "Alon Ohad",
  "homepage": "https://meshit30.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alono/meshit30.git"
  },
  "bugs": {
    "url": "https://github.com/alono/meshit30/issues"
  },
  "scripts": {
    "terms": "node scripts/build-terms.mjs --all",
    "display": "node scripts/build-display.mjs --all",
    "validate": "node scripts/validate-subject.mjs --all",
    "content": "npm run terms && npm run display && npm run validate",
    "dev": "vite",
    "build": "vite build && node scripts/build-sw.mjs",
    "preview": "vite preview",
    "check:theme": "node scripts/check-theme.mjs",
    "test": "node --test",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "vite": "5.4.11"
  }
}
